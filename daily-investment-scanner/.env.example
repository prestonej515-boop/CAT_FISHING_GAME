# ============================================================
# Daily Investment Scanner — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# --- Questrade OAuth2 ---
# Get your refresh token from: https://login.questrade.com/APIAccess
# After first auth, the app will update this automatically.
QUESTRADE_REFRESH_TOKEN=your_refresh_token_here

# The Questrade API server URL — populated automatically after first token refresh.
# Leave blank on first run; the app fills it in.
QUESTRADE_API_SERVER=

# --- Slack ---
# Create an incoming webhook at: https://api.slack.com/apps → Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# --- Optional Overrides ---
# Comma-separated account IDs to include (leave blank to auto-detect all accounts)
QUESTRADE_ACCOUNT_IDS=

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Path to the log file (relative to project root)
LOG_FILE=logs/scanner.log
